# This file defines the mapping of the FPGA pin number to 
# signal names as used in main.v. We included here only the
# signals that actually used by this example.

#set_io X 45
set_io Y 46
set_io TMDSD0S 36
set_io TMDSD1S 37
set_io TMDSD2S 38
set_io CE0 13
set_io CE1 16
set_io CE2 18
set_io Si00 41
set_io Si01 42
set_io SI02 43
set_io SIO3 44
set_io RAMCLK 45

set_io CLK  49  # input

